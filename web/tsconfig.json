{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"#lib": ["./src/lib/index.ts"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src",
		"vite.config.ts",
		"playwright.config.ts"
	],
	"exclude": [
		"src/service-worker",
		"src/service-worker.ts",
		"src/**/*.spec.ts",
		"src/lib/api/contract.ts"
	]
}
